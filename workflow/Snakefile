# Load configuration        
configfile: "config/config.yaml"    
# Rule all: define the final outputs of the workflow
rule all:
    input:
        expand("results/qc/raw_fastqc/{sample}_R{read}_fastqc.html",
               sample=config["samples"],
               read=[1, 2]),
        expand("results/trimmed/{sample}_R{read}_trimmed.fastq.gz",
               sample=config["samples"],
               read=[1, 2]),
        expand("results/qc/trimmed_fastqc/{sample}_R{read}_trimmed_fastqc.html",
               sample=config["samples"],
               read=[1, 2]),
        "results/qc/multiqc_report.html",
        "results/star_index",
        expand("results/aligned/{sample}.sorted.bam", sample=config["samples"]),
        expand("results/aligned/{sample}.sorted.bam.bai", sample=config["samples"]),
        expand("results/stats/{sample}.alignment_stats.txt", sample=config["samples"]),
        expand("results/counts/{sample}.counts.txt", sample=config["samples"]),
        "results/counts/count_matrix.tsv",
        "results/analysis/pca_plot.pdf",
        "results/analysis/correlation_heatmap.pdf",
        "results/deseq2/deseq2_dataset.rds",
        "results/deseq2/normalized_counts.tsv"


# ============================================================================
# TASK 1: Quality Control and Trimming
# ============================================================================

rule fastqc_raw:
    input:
        "raw/{sample}_R{read}.fastq.gz"
    output:
        "results/qc/raw_fastqc/{sample}_R{read}_fastqc.html",
        "results/qc/raw_fastqc/{sample}_R{read}_fastqc.zip"
    log:
        "logs/fastqc_raw/{sample}_R{read}.log"
    shell:
        "fastqc {input} --outdir results/qc/raw_fastqc/ > {log} 2>&1"
rule trim_galore:
    input:
        r1 = "raw/{sample}_R1.fastq.gz",
        r2 = "raw/{sample}_R2.fastq.gz"
    output:
        r1 = "results/trimmed/{sample}_R1_trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_R2_trimmed.fastq.gz"
    log:
        "logs/trim_galore/{sample}.log"
    shell:
        "trim_galore --paired --gzip -o results/trimmed/ "
        "{input.r1} {input.r2} > {log} 2>&1 && "
        "mv results/trimmed/{wildcards.sample}_R1_val_1.fq.gz {output.r1} && "
        "mv results/trimmed/{wildcards.sample}_R2_val_2.fq.gz {output.r2}"
rule fastqc_trimmed:
    input:
        r1 = "results/trimmed/{sample}_R1_trimmed.fastq.gz",
        r2 = "results/trimmed/{sample}_R2_trimmed.fastq.gz"
    output:
        "results/qc/trimmed_fastqc/{sample}_R1_trimmed_fastqc.html",
        "results/qc/trimmed_fastqc/{sample}_R1_trimmed_fastqc.zip",
        "results/qc/trimmed_fastqc/{sample}_R2_trimmed_fastqc.html",
        "results/qc/trimmed_fastqc/{sample}_R2_trimmed_fastqc.zip"
    log:
        "logs/fastqc_trimmed/{sample}.log"
    shell:
        "fastqc {input.r1} {input.r2} --outdir results/qc/trimmed_fastqc/ > {log} 2>&1"
rule multiqc:
    input:
        expand("results/qc/raw_fastqc/{sample}_R{read}_fastqc.zip",
               sample=config["samples"], read=[1, 2]),
        expand("results/qc/trimmed_fastqc/{sample}_R{read}_trimmed_fastqc.zip",
               sample=config["samples"], read=[1, 2])
    output:
        "results/qc/multiqc_report.html"
    log:
        "logs/multiqc/multiqc.log"
    shell:
        "multiqc results/qc/raw_fastqc/ results/qc/trimmed_fastqc/ "
        "--outdir results/qc/ > {log} 2>&1"


# ============================================================================
# TASK 2: Read Alignment
# ============================================================================

rule star_index:
    input:
        genome = config["genome"],
        gtf    = config["gtf"]
    output:
        directory("results/star_index")
    log:
        "logs/star_index/star_index.log"
    shell:
        "STAR --runMode genomeGenerate "
        "--genomeDir {output} "
        "--genomeFastaFiles {input.genome} "
        "--sjdbGTFfile {input.gtf} "
        "--runThreadN 4 > {log} 2>&1"
rule star_align:
    input:
        r1    = "results/trimmed/{sample}_R1_trimmed.fastq.gz",
        r2    = "results/trimmed/{sample}_R2_trimmed.fastq.gz",
        index = "results/star_index"
    output:
        "results/aligned/{sample}.bam"
    log:
        "logs/star_align/{sample}.log"
    shell:
        "STAR --runMode alignReads "
        "--genomeDir {input.index} "
        "--readFilesIn {input.r1} {input.r2} "
        "--readFilesCommand zcat "
        "--outSAMtype BAM Unsorted "
        "--outTmpDir /tmp/STAR_{wildcards.sample} "
        "--outStd BAM_Unsorted > {output} 2> {log}"
rule sort_bam:
    input:
        "results/aligned/{sample}.bam"
    output:
        "results/aligned/{sample}.sorted.bam"
    log:
        "logs/sort_bam/{sample}.log"
    shell:
        "samtools sort {input} -o {output} > {log} 2>&1"
rule index_bam:
    input:
        "results/aligned/{sample}.sorted.bam"
    output:
        "results/aligned/{sample}.sorted.bam.bai"
    log:
        "logs/index_bam/{sample}.log"
    shell:
        "samtools index {input} > {log} 2>&1"
rule alignment_stats:
    input:
        "results/aligned/{sample}.sorted.bam"
    output:
        "results/stats/{sample}.alignment_stats.txt"
    log:
        "logs/alignment_stats/{sample}.log"
    shell:
        "samtools flagstat {input} > {output} 2> {log}"


# ============================================================================
# TASK 3: Read Quantification
# ============================================================================

rule feature_counts:
    input:
        bam = "results/aligned/{sample}.sorted.bam",
        gtf = config["gtf"]
    output:
        "results/counts/{sample}.counts.txt"
    log:
        "logs/feature_counts/{sample}.log"
    shell:
        "featureCounts -T 4 -p -a {input.gtf} -o {output} {input.bam} > {log} 2>&1"


# ============================================================================
# TASK 4: Count Matrix
# ============================================================================

rule aggregate_counts:
    input:
        expand("results/counts/{sample}.counts.txt", sample=config["samples"])
    output:
        "results/counts/count_matrix.tsv"
    log:
        "logs/aggregate_counts/aggregate_counts.log"
    script:
        "scripts/aggregate_counts.py"


# ============================================================================
# TASK 5: Exploratory Analysis
# ============================================================================

rule plot_pca:
    input:
        counts   = "results/counts/count_matrix.tsv",
        metadata = "config/samples.tsv"
    output:
        "results/analysis/pca_plot.pdf"
    params:
        n_top_genes = 500
    log:
        "logs/plot_pca/plot_pca.log"
    script:
        "scripts/plot_pca.R"
rule plot_correlation:
    input:
        counts   = "results/counts/count_matrix.tsv",
        metadata = "config/samples.tsv"
    output:
        "results/analysis/correlation_heatmap.pdf"
    params:
        method = "pearson"
    log:
        "logs/plot_correlation/plot_correlation.log"
    script:
        "scripts/plot_correlation.R"


# ============================================================================
# TASK 6: DESeq2 
# ============================================================================

rule prepare_deseq2:
    input:
        counts   = "results/counts/count_matrix.tsv",
        metadata = "config/samples.tsv"
    output:
        dds        = "results/deseq2/deseq2_dataset.rds",
        normalized = "results/deseq2/normalized_counts.tsv"
    params:
        min_count = 10
    log:
        "logs/prepare_deseq2/prepare_deseq2.log"
    script:
        "scripts/prepare_deseq2.R"

